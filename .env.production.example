DJANGO_SETTINGS_MODULE=cctv_analytics.settings.production
DEPLOYMENT_ENVIRONMENT=production
PLATFORM_VERSION=3.1.0
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=incidents.example.go.ug
CSRF_TRUSTED_ORIGINS=https://incidents.example.go.ug
DJANGO_TIME_ZONE=Africa/Kampala
REQUIRE_AUTHENTICATION=1
ENFORCE_RBAC=1

INGEST_API_TOKEN=replace-with-a-random-service-token
INGEST_BATCH_LIMIT=1000
INGEST_RATE_LIMIT_PER_MINUTE=6000

POSTGRES_DB=cctv_analytics
POSTGRES_USER=cctv_app
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=database.internal
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
DB_CONN_MAX_AGE=120
DB_STATEMENT_TIMEOUT_MS=60000
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT=30

REDIS_URL=redis://redis.internal:6379/0
CHANNEL_REDIS_URL=redis://redis.internal:6379/0
CELERY_BROKER_URL=redis://redis.internal:6379/1
CACHE_REDIS_URL=redis://redis.internal:6379/2

ASYNC_DATASET_IMPORTS=1
AUTO_IMPORT_DATASETS=0
ANALYTICS_CACHE_TTL=300
JSON_LOGS=1
LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

USE_S3_STORAGE=1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_STORAGE_BUCKET_NAME=incident-platform
AWS_S3_ENDPOINT_URL=https://object-storage.internal
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
