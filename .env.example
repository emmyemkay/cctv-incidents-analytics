# -----------------------------------------------------------------------------
# Core development runtime
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=cctv_analytics.settings.development
DEPLOYMENT_ENVIRONMENT=development
PLATFORM_VERSION=3.1.0-dev
DJANGO_SECRET_KEY=replace-with-a-long-random-development-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web,nginx
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,http://localhost:8080,http://127.0.0.1:8080
DJANGO_TIME_ZONE=Africa/Kampala
REQUIRE_AUTHENTICATION=0
ENFORCE_RBAC=0
WEB_PORT=8001
POSTGRES_DEV_PORT=5433
REDIS_DEV_PORT=6380
ENABLE_DEBUG_TOOLBAR=1

# API ingestion
INGEST_API_TOKEN=replace-with-a-private-service-token
INGEST_BATCH_LIMIT=1000
INGEST_RATE_LIMIT_PER_MINUTE=6000

# PostgreSQL - standard PostgreSQL, deliberately no PostGIS
USE_POSTGRES=1
POSTGRES_DB=cctv_analytics
POSTGRES_USER=cctv
POSTGRES_PASSWORD=replace-with-a-strong-development-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
DB_CONN_MAX_AGE=0
DB_CONNECT_TIMEOUT=10

# Redis logical separation
USE_REDIS=1
REDIS_URL=redis://redis:6379/0
CHANNEL_REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CACHE_REDIS_URL=redis://redis:6379/2
CHANNEL_CAPACITY=1500
CHANNEL_EXPIRY_SECONDS=60

# Background processing and analytics
ASYNC_DATASET_IMPORTS=1
AUTO_IMPORT_DATASETS=1
ANALYTICS_CACHE_TTL=300
CELERY_DEV_QUEUES=imports,analytics,default,celery
CELERY_DEV_CONCURRENCY=2
CELERY_IMPORT_CONCURRENCY=1
CELERY_ANALYTICS_CONCURRENCY=2

# Development logging
JSON_LOGS=0
LOG_LEVEL=INFO

# Optional edge profile
NGINX_PORT=8080

# Optional Mailpit profile
USE_MAILPIT=0
EMAIL_HOST=mailpit
EMAIL_PORT=1025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Optional MinIO/S3 profile
USE_S3_STORAGE=0
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_STORAGE_BUCKET_NAME=incident-platform
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path

# Optional database tools profile
ADMINER_PORT=8081

# Optional monitoring profile
FLOWER_PORT=5555
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
